//Begin FXD1
switch (FEAT_TRAINS, SELF, switch_fxd1_name, getbits(extra_callback_info1, 0, 8) == 0x20? getbits(extra_callback_info1, 8, 8) : 0xFFFF) {
    0: return string(STR_FXD1_SERIES);
    return CB_RESULT_NO_TEXT;
}

//Graphics

//Purchase menu
spriteset (spriteset_fxd1_purchase_original, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("25-electric", "fxd1-front")
}

//Vehicle
spriteset (spriteset_hxd1g_front, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("25-electric","hxd1g-front")
}
spriteset (spriteset_hxd1g_back, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard("25-electric","hxd1g-back")
}
spriteset (spriteset_fxd1_front, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("25-electric", "fxd1-front")
}
spriteset (spriteset_fxd1_back, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("25-electric", "fxd1-back")
}

switch (FEAT_TRAINS, SELF, switch_fxd1_articulated_part, extra_callback_info1) {
    1..5: return fxd1;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch(FEAT_TRAINS, SELF, switch_hxd1g_cargo_subtype, cargo_subtype) {
    0: return string(STR_BUILD_YEAR);
    1: return string(STR_HXD_G,1);
    2: return string(STR_FXD,1);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_TRAINS, SELF, switch_fxd1_livery_graphics, position_in_articulated_veh % 6) {
    1: spriteset_fxd1_front;
    4: spriteset_fxd1_back;
    empty_sprites;
}

switch (FEAT_TRAINS, SELF, switch_hxd1g_livery_graphics, position_in_articulated_veh % 6) {
    1: spriteset_hxd1g_front;
    4: spriteset_hxd1g_back;
}

switch (FEAT_TRAINS, SELF, switch_hxd1g_cargo_subtype_0, build_year) {
    0..2019: switch_hxd1g_livery_graphics;
    return switch_fxd1_livery_graphics;
}

switch (FEAT_TRAINS, SELF, switch_fxd1_graphics, position_in_articulated_veh % 3)  {
    1: return switch_hxd1g_cargo_subtype_0;
    empty_sprites;
}

item (FEAT_TRAINS, fxd1) {
    property {
        // Menu
        name: string (STR_NAME_FXD1);
        sprite_id: SPRITE_ID_NEW_TRAIN;
        misc_flags: bitmask (TRAIN_FLAG_AUTOREFIT);
        engine_class: ENGINE_CLASS_ELECTRIC;
        variant_group:                  hxd1f;

        // Availability
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2017,05,01);
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        track_type:                     SACA;


        // Cargo
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes:   0;
        cargo_allow_refit:              [];
        cargo_disallow_refit:           [];
        refit_cost:                     0;
        default_cargo_type:             PASS;
        ai_special_flag:                AI_FLAG_PASSENGER;
        cargo_capacity:                 1;
        loading_speed:                  8 << param_loading_speed;
        cargo_age_period:               185 << param_cargo_decay;

        // Stats
        speed: 160 km/h;
        power: 11200 kW;
        weight: 156 ton;
        tractive_effort_coefficient:    0.313;
        cost_factor:                    83;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        running_cost_factor:            72;
        reliability_decay:              8;
    }
    graphics{
        // Menu
        additional_text:                string(STR_DESC_4, string(STR_ELECTRICITY_SUPPLY_YES),  string(STR_FULL_NAME_FXD1), string(STR_ALIASNAME_FXD1), string(STR_RELDEC_LOW, 8));
        cargo_subtype_text:             switch_hxd1g_cargo_subtype;
        can_attach_wagon:               locowagon;
        
        // Graphics
        default:                        switch_hxd1g_cargo_subtype_0;
        purchase:                       spriteset_fxd1_purchase_original;
        articulated_part:               switch_fxd1_articulated_part;

        // Stats
        length:                         switch_length_2_6_2;
        cargo_capacity:                 0;
        cost_factor:                    126;
        running_cost_factor:            120 * runningcostfactor();
        purchase_running_cost_factor:   402;
        purchase_cargo_capacity:        0;
        bitmask_vehicle_info:           0;
        name:                           switch_fxd1_name;
    }
}

//End FXD1
