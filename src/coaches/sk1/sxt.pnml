//Begin SXT



// Graphics

// Purchase Menu
spriteset (spriteset_sxt_purchase_original, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("dmu", "nm1/sxt")
}

// Vehicle
spriteset (spriteset_sxt_original, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("dmu", "nm1/sxt")
}


switch (FEAT_TRAINS, SELF, switch_sxt_articulated_part, extra_callback_info1) {
    1..2: return sxt;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}



switch (FEAT_TRAINS, SELF, switch_sxt_graphics, position_in_articulated_veh % 3) {
    1: spriteset_sxt_original;
    empty_sprites;
}

switch (FEAT_TRAINS, SELF, switch_sxt_capacity, position_in_articulated_veh % 3) {
    1: return 68;
    return 0;
}


item (FEAT_TRAINS, sxt) {
    property {
        // Menu
        name:                           string(STR_NAME_SXT);
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT);
        variant_group:					sk1;

        // Availability
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1961,01,01);
        model_life:                     30;
        vehicle_life:                   30;
        track_type:                     SACN;

        // Cargo
        refittable_cargo_classes:       bitmask(CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes:   0;
        cargo_allow_refit:              [MAIL, VALU, GOLD, DIAM];
        cargo_disallow_refit:           [];
        refit_cost:                     0;
        default_cargo_type:             MAIL;
        ai_special_flag:                AI_FLAG_CARGO;
        cargo_capacity:                 68;
        loading_speed:                  6 << param_loading_speed;
        cargo_age_period:               185 << param_cargo_decay;

        // Stats
        speed:                          120 km/h;
        power:                          0 hp;
        weight:                         56 ton;
        cost_factor:                    8;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        running_cost_factor:            6;
        bitmask_vehicle_info:           bitmask(2);
    }
    graphics {
        // Menu
        additional_text:                string(STR_DESC_3,  string(STR_FRESHNESS_MEDIUM, 200), string(STR_AIR_CONDITIONER_EFFECT));
        can_attach_wagon:               locowagon;

        // Graphics
        default:                        switch_sxt_graphics;
        purchase:                       spriteset_sxt_purchase_original;
        articulated_part:               switch_sxt_articulated_part;

        // Stats
        length:                         switch_length_2_8_2;
        cargo_capacity:                 switch_sxt_capacity;
        cargo_age_period:               200 << (param_cargo_decay + param_wagoncargodecay);
        cost_factor:                    9;
        running_cost_factor:            6 * runningcostfactor() * cafecostfactor() + 20;
        purchase_running_cost_factor:   44;
        purchase_cargo_capacity:        68/3;
        name:                           switch_sk1_name;

    }
}

// End SXT
