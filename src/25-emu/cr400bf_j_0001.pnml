switch (FEAT_TRAINS, SELF, switch_cr400bf_j_0001_name, getbits(extra_callback_info1, 0, 8) == 0x20? getbits(extra_callback_info1, 8, 8) : 0xFFFF) {
    0: return string(STR_CR400BF_SERIES);
    return CB_RESULT_NO_TEXT;
}

