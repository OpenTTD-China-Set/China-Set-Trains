//CRH380BJA

spriteset(spriteset_crh380bja_purchase_original, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard("25-emu/crh380bja", "crh380bja-c")
}


spriteset(spriteset_crh380bja_head, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard("25-emu/crh380bja", "crh380bja-c")
}
spriteset(spriteset_crh380bja_head_reconnect, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard("25-emu/crh380bja", "crh380bja-c-c")
}
spriteset(spriteset_crh380bja_tp2, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_reversed("25-emu/crh380bja", "crh380bja-tp-b")
}
spriteset(spriteset_crh380bja_m03, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard("25-emu/crh380bja", "crh380bja-m-36")
}
