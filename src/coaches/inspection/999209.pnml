switch (FEAT_TRAINS, SELF, switch_999209_name, getbits(extra_callback_info1, 0, 8) == 0x20? getbits(extra_callback_info1, 8, 8) : 0xFFFF) {
    0: return string(STR_INSPECTION_SERIES);
    return CB_RESULT_NO_TEXT;
}


// Graphics

// Purchase Menu
spriteset (spriteset_999209_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("coaches/inspection", "999209")
}

// Vehicle
spriteset (spriteset_999209, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("coaches/inspection", "999209")
}

switch (FEAT_TRAINS, SELF, switch_999209_articulated_part, extra_callback_info1) {
    1..2: return sy25t999209;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, switch_999209_graphics, position_in_articulated_veh % 3) {
    1: spriteset_999209;
    empty_sprites;
}

item (FEAT_TRAINS, sy25t999209) {
    property {
        // Menu
        name:                           string(STR_NAME_999209);
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT);
        variant_group:					2202;

        // Availability
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2013,08,01);
        model_life:                     30;
        vehicle_life:                   30;
        track_type:                     SACN;

        // Cargo
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes:   0;
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        cargo_disallow_refit:           [];
        refit_cost:                     0;
        default_cargo_type:             PASS;
        ai_special_flag:                AI_FLAG_PASSENGER;
        cargo_capacity:                 0;
        loading_speed:                  4 << param_loading_speed;
        cargo_age_period:               185 << param_cargo_decay;

        // Stats
        speed:                          160 km/h;
        power:                          0 hp;
        weight:                         55.3 ton;
        cost_factor:                    8;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        running_cost_factor:            0;
    }
    graphics {
        // Menu
        additional_text:                string(STR_DESC_4, string(STR_FULL_NAME_999209));
        can_attach_wagon:               locowagon;

        // Graphics
        default:                        switch_999209_graphics;
        purchase:                       spriteset_999209_purchase;
        articulated_part:               switch_999209_articulated_part;

        // Stats
        length:                         switch_length_2_8_2;
        cost_factor:                    28;
        running_cost_factor:            0;
        purchase_running_cost_factor:   0;
        purchase_cargo_capacity:        0;
        name:                           switch_999209_name;

    }
}

// End 999209

