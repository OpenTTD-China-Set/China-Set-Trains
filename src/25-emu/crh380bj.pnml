spriteset(spriteset_crh380bj_rear, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_reversed("25-emu/crh380bj", "crh380bj-c")
}

switch(FEAT_TRAINS, SELF, switch_crh380bj_articulated_part, extra_callback_info1) {
    1..23: return crh380bj;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch(FEAT_TRAINS, SELF, switch_crh380bj_graphics, position_in_articulated_veh % 24) {
    1: return spriteset_crh380bj_head;
    4: return spriteset_crh380bj_tp2;
    7: return spriteset_crh380bj_m03;
    10: return spriteset_crh380bj_m04;
    13: return spriteset_crh380bj_m05;
    16: return spriteset_crh380bj_m06;
    19: return spriteset_crh380bj_tp;
    22: return spriteset_crh380bj_rear;
    empty_sprites;
}

switch(FEAT_TRAINS, SELF, switch_crh380bj_speed, cargo_subtype) {
    0: return 385;
    1: return 418;
}

switch(FEAT_TRAINS, SELF, switch_crh380bj_cargo_subtype, cargo_subtype) {
    0: return string(STR_ORIGIN_SPEED);
    1: return string(STR_CRH380BJ_EXPERIMENTAL_SPEED);
}

switch (FEAT_TRAINS, SELF, onlycrh380bj, vehicle_type_id) {
    crh380bj: onlyallowcst;
    return CB_RESULT_ATTACH_DISALLOW;
}

item (FEAT_TRAINS, crh380bj) {
    property {
        // Menu
        name:                           string(STR_NAME_CRH380BJ);
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_MU);
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        variant_group:                  9227;

        // Availability
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2011,05,01);
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   25;
        track_type:                     SAAA;

        // Cargo
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes:   0;
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        cargo_disallow_refit:           [];
        refit_cost:                     0;
        default_cargo_type:             PASS;
        ai_special_flag:                AI_FLAG_PASSENGER;
        cargo_capacity:                 1;
        loading_speed:                  8 << param_loading_speed;
        cargo_age_period:               185 << param_cargo_decay;

        // Stats
        speed:                          385 km/h;
        power:                          13800 kW;
        weight:                         482 ton;
        tractive_effort_coefficient:    0.051;
        cost_factor:                    1;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        running_cost_factor:            1;
        reliability_decay:              8;
        bitmask_vehicle_info:           bitmask(2);

    }
        graphics {
        // Menu
        additional_text:                string(STR_DESC_6, string(STR_RELDEC_LOW, 8), string(STR_CRH380BJ_AVAILABLE));
        can_attach_wagon:               onlycrh380bj;
        start_stop:                     mu4to24car;
        cargo_subtype_text:             switch_crh380bj_cargo_subtype;

        // Graphics
        default:                        switch_crh380bj_graphics;
        purchase:                       spriteset_crh380bj_purchase_original;
        articulated_part:               switch_crh380bj_articulated_part;

        // Stats
        length:                         switch_length_2_8_2;
        speed:                          switch_crh380bj_speed;
        purchase_tractive_effort_coefficient: return int(0.083*255);
        cargo_capacity:                 0;
        cost_factor:                    67;
        running_cost_factor:            0;
        purchase_running_cost_factor:   0;
        purchase_cargo_capacity:        0;
        name:                           switch_crh380bj_name;
    }
}