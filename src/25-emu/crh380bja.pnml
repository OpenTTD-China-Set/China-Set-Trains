}
spriteset(spriteset_crh380bja_m05, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_reversed("25-emu/crh380bja", "crh380bja-m-5")
}
spriteset(spriteset_crh380bja_m06, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
