// Begin NM1

// Graphics

// Purchase Menu
spriteset (spriteset_nm1_purchase_original, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("dmu/nm1", "nm1")
}

// Vehicle
spriteset (spriteset_nm1_front, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("dmu/nm1", "nm1")
}
spriteset (spriteset_nm1_back, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_reversed_11 ("dmu/nm1", "nm1")
}

switch (FEAT_TRAINS, SELF, switch_nm1_articulated_part, extra_callback_info1) {
    1..2: return nm1;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, nm1wagon, vehicle_type_id) {
    sk1: onlyallowcst;
    nm1: onlyallowcst;
    return CB_RESULT_ATTACH_DISALLOW;
}


switch (FEAT_TRAINS, SELF, switch_nm1_start_stop, !hasbit(bitmask_consist_info, 0) && (num_vehs_in_consist >= 12) && (count_veh_id(8198) == 6) && ((position_in_consist < 3) || (position_in_consist_from_end < 3))) {
    0: return string(STR_NM1_CONSIST);
    return CB_RESULT_NO_TEXT;
}



switch (FEAT_TRAINS, SELF, switch_nm1_graphics_position_error_control, position_in_consist_from_end % 3) {
    0: empty_sprites;
    2: empty_sprites;
    spriteset_erroremu;
}

switch (FEAT_TRAINS, SELF, switch_nm1_graphics_front, position_in_consist) {
    1: spriteset_nm1_front;
    switch_nm1_graphics_position_error_control;
}

switch (FEAT_TRAINS, SELF, switch_nm1_graphics, (position_in_consist_from_end == 1) && (position_in_consist != 1)) {
    1: spriteset_nm1_back;
    switch_nm1_graphics_front;
}


item (FEAT_TRAINS, nm1) {
    property {
        // Menu
        name:                           string(STR_NAME_NM1);
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_MU);
        engine_class:                   ENGINE_CLASS_DIESEL;

        // Availability
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1958,10,01);
        model_life:                     15;
        vehicle_life:                   10;
        retire_early:                   10;
        track_type:                     SACN;

        // Cargo
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes:   0;
        cargo_allow_refit:              [];
        cargo_disallow_refit:           [];
        refit_cost:                     0;
        default_cargo_type:             PASS;
        ai_special_flag:                AI_FLAG_PASSENGER;
        cargo_capacity:                 1;
        loading_speed:                  8 << param_loading_speed;
        cargo_age_period:               185 << param_cargo_decay;

        // Stats
        speed:                          90 km/h;
        power:                          440 kW;
        weight:                         65 ton;
        tractive_effort_coefficient:    0.12;
        cost_factor:                    60;
        running_cost_base:              RUNNING_COST_DIESEL;
        running_cost_factor:            45;
        reliability_decay:              30;
        bitmask_vehicle_info:           bitmask(2);
    }
    graphics {
        // Menu
        additional_text:                string(STR_DESC_4, string(STR_NM1_CONSIST), string(STR_RELDEC_VERY_HIGH, 30));
        can_attach_wagon:               nm1wagon;
        start_stop:                     switch_nm1_start_stop;

        // Graphics
        default:                        switch_nm1_graphics;
        purchase:                       spriteset_nm1_purchase_original;
        articulated_part:               switch_nm1_articulated_part;

        // Stats
        length:                         switch_length_2_7_2;
        cargo_capacity:                 0;
        cost_factor:                    60;
        running_cost_factor:            45 * runningcostfactor();
        purchase_running_cost_factor:   180;
        purchase_cargo_capacity:        0;
        bitmask_vehicle_info:           switch_pushpull_consist_correction;
    }
}

// End NM1