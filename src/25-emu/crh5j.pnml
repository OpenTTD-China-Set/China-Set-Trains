//Begin crh5j
switch (FEAT_TRAINS, SELF, switch_crh5j_name, getbits(extra_callback_info1, 0, 8) == 0x20? getbits(extra_callback_info1, 8, 8) : 0xFFFF) {
    0: return string(STR_CRH5_SERIES);
    return CB_RESULT_NO_TEXT;
}

//Graphics

//Purchae menu
spriteset(spriteset_crh5j_purchase_original, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("25-emu", "crh5j-mc")
}

//vehicle
spriteset(spriteset_crh5j_head, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("25-emu", "crh5j-mc")
}
spriteset(spriteset_crh5j_47, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("25-emu", "crh5j-m47")
}
spriteset(spriteset_crh5j_235, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("25-emu", "crh5j-m235")
}
spriteset(spriteset_crh5j_tp, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("25-emu", "crh5j-tp")
}
spriteset(spriteset_crh5j_rear, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_reversed ("25-emu", "crh5j-mc")
}
spriteset(spriteset_crh5j_tp2, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_reversed ("25-emu", "crh5j-tp2")
}

switch(FEAT_TRAINS, SELF, switch_crh5j_articulated_part, extra_callback_info1) {
    1..23: return crh5j;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

