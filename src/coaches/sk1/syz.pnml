// Begin SYZ

// Graphics

// Purchase Menu
spriteset (spriteset_syz_purchase_original, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("dmu", "nm1/syz")
}

// Vehicle
spriteset (spriteset_syz_original, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("dmu", "nm1/syz")
}


switch (FEAT_TRAINS, SELF, switch_syz_articulated_part, extra_callback_info1) {
    1..2: return syz;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}


switch (FEAT_TRAINS, SELF, switch_syz_graphics, position_in_articulated_veh % 3) {
    1: spriteset_syz_original;
    empty_sprites;
}

switch (FEAT_TRAINS, SELF, switch_syz_capacity, position_in_articulated_veh % 3) {
    1: return 128;
    return 0;
}


item (FEAT_TRAINS, syz) {
    property {
        // Menu
        name:                           string(STR_NAME_SYZ);
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT);
        variant_group:					sk1;

        // Availability
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1961,01,01);
        model_life:                     30;
        vehicle_life:                   30;
        track_type:                     SACN;

        // Cargo
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes:   0;
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        cargo_disallow_refit:           [];
        refit_cost:                     0;
        default_cargo_type:             PASS;
        ai_special_flag:                AI_FLAG_PASSENGER;
        cargo_capacity:                 128;
        loading_speed:                  8 << param_loading_speed;
        cargo_age_period:               185 << param_cargo_decay;

        // Stats
        speed:                          120 km/h;
        power:                          0 hp;
        weight:                         53 ton;
        cost_factor:                    8;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        running_cost_factor:            6;
    }
    graphics {
        // Menu
        additional_text:                string(STR_DESC_4, string(STR_COMFORT_LOW, 144), string(STR_NO_AIR_CONDITIONER));
        can_attach_wagon:               locowagon;

        // Graphics
        default:                        switch_syz_graphics;
        purchase:                       spriteset_syz_purchase_original;
        articulated_part:               switch_syz_articulated_part;

        // Stats
        length:                         switch_length_2_8_2;
        cargo_capacity:                 switch_syz_capacity;
        cargo_age_period:               (9 * 4 * cafedecayfactor()) << param_cargo_decay;
        cost_factor:                    7;
        running_cost_factor:            5 * runningcostfactor() * cafecostfactor(); // NO AC FUNCTION
        purchase_running_cost_factor:   20;
        purchase_cargo_capacity:        128/3;
        name:                           switch_sk1_name;
    }
}

// End SYZ