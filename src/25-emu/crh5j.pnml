switch(FEAT_TRAINS, SELF, switch_crh5j_graphics, position_in_articulated_veh % 24) {
    1: return spriteset_crh5j_head;
    4: return spriteset_crh5j_235;
    7: return spriteset_crh5j_tp2;
    10: return spriteset_crh5j_47;
    13: return spriteset_crh5j_235;
    16: return spriteset_crh5j_tp;
    19: return spriteset_crh5j_47;
    22: return spriteset_crh5j_rear;
    empty_sprites;
}

switch (FEAT_TRAINS, SELF, onlycrh5j, vehicle_type_id) {
    crh5j: onlyallowcst;
    return CB_RESULT_ATTACH_DISALLOW;
}

switch(FEAT_TRAINS, SELF, switch_crh5j_speed, cargo_subtype) {
    1: return 275;
    2: return 300;
    return 250;
}

switch(FEAT_TRAINS, SELF, switch_crh5j_cargo_subtype, cargo_subtype) {
    0: return string(STR_ORIGIN_SPEED);
    1: return string(STR_CRH5J_DESIGNED_SPEED);
    2: return string(STR_CRH5J_EXPERIMENTAL_SPEED);
    return CB_RESULT_NO_TEXT;
}

//item
item (FEAT_TRAINS, crh5j) {
    property {
        // Menu
        name:                           string(STR_NAME_CRH5J);
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_MU);
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        variant_group:					crh5a;

        // Availability
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2008,06,30);
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   25;
        track_type:                     SABA;

        // Cargo
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes:   0;
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        cargo_disallow_refit:           [];
        refit_cost:                     0;
        default_cargo_type:             PASS;
        ai_special_flag:                AI_FLAG_PASSENGER;
        cargo_capacity:                 1;
        loading_speed:                  8 << param_loading_speed;
        cargo_age_period:               185 << param_cargo_decay;

        // Stats
        speed:                          250 km/h;
        power:                          5500 kW;
        weight:                         482 ton;
        tractive_effort_coefficient:    0.0167;
        cost_factor:                    1;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        running_cost_factor:            1;
        reliability_decay:              12;
        bitmask_vehicle_info:           bitmask(2);

    }
    graphics {
        // Menu
        additional_text:                string(STR_DESC_6, string(STR_RELDEC_LOW, 12), string(STR_CRH5J_AVAILABLE));
        can_attach_wagon:               onlycrh5j;
        start_stop:                     mu4to24car;
        cargo_subtype_text:             switch_crh5j_cargo_subtype;

        // Graphics
        default:                        switch_crh5j_graphics;
        purchase:                       spriteset_crh5j_purchase_original;
        articulated_part:               switch_crh5j_articulated_part;

        // Stats
        length:                         switch_length_2_8_2;
        speed:                          switch_crh5j_speed;
        purchase_tractive_effort_coefficient: return int(0.083*255);//I don't know what does it represent
        cargo_capacity:                 0;
        cost_factor:                    67;
        running_cost_factor:            0;
        purchase_running_cost_factor:   0;
        purchase_cargo_capacity:        0;
        name:                           switch_crh5j_name;
    }
}

//End crh5j